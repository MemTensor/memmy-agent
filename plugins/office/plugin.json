{
  "apiVersion": "memmy/v1",
  "id": "office",
  "name": "Office",
  "version": "0.2.3",
  "rules": {
    "distribution": "public",
    "installation": "manual",
    "requiresLogin": false,
    "unavailableVisibility": "visible",
    "autoUpdate": true,
    "recommendsOfficialModel": false
  },
  "runtime": {
    "adapter": "command",
    "config": {
      "command": "runtime/main.cjs",
      "interpreter": "node",
      "inputMode": "stdin-json",
      "outputMode": "ndjson",
      "runtimeDependencies": [
        "office"
      ],
      "timeoutMs": 300000,
      "maxOutputBytes": 16777216,
      "sandbox": "required"
    }
  },
  "permissions": [
    {
      "type": "host-service",
      "services": [
        "plugin-data",
        "file-input",
        "artifact-host"
      ],
      "description": "读取用户上传的办公文件，在插件专属目录中处理，并将最终文件交付到当前会话。"
    }
  ],
  "skills": [
    {
      "id": "office-docx",
      "name": "Office DOCX",
      "description": "Create, inspect, edit, render and deliver DOCX files through the Office plugin.",
      "entry": "skills/office-docx/SKILL.md"
    },
    {
      "id": "office-pdf",
      "name": "Office PDF",
      "description": "Create, inspect, edit, render and deliver PDF files through the Office plugin.",
      "entry": "skills/office-pdf/SKILL.md"
    },
    {
      "id": "office-pptx",
      "name": "Office PPTX",
      "description": "Create, inspect, edit, render and deliver PPTX files through the Office plugin.",
      "entry": "skills/office-pptx/SKILL.md"
    },
    {
      "id": "office-xlsx",
      "name": "Office XLSX",
      "description": "Create, inspect, edit, render and deliver XLSX files through the Office plugin.",
      "entry": "skills/office-xlsx/SKILL.md"
    }
  ],
  "scenarios": [
    {
      "id": "office",
      "name": "制作办公文档",
      "description": "创建或修改 Word、Excel、PPT 和 PDF",
      "icon": "FileText",
      "prompt": "使用 Office 插件帮我制作办公文档。先根据我的需求确定文件格式，再生成、检查并交付文件。"
    }
  ],
  "capabilities": [
    {
      "id": "office_status",
      "name": "office status",
      "description": "Check supported operations and whether LibreOffice/Poppler are available before starting. Missing runtimes must be reported, never treated as successful QA.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_import",
      "name": "office import",
      "description": "Copy an uploaded DOCX/PDF/PPTX/XLSX/CSV/TSV into an isolated task. Keep the original unchanged. Returns taskId and file name for later operations.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_execute",
      "name": "office execute",
      "description": "Advanced Office authoring/editing: run an async JavaScript body with preloaded docx, ExcelJS, PptxGenJS, JSZip, PDFLib, DOMParser, XMLSerializer, fs, path and workspace. A fresh task copies selected inputFiles from sourceTaskId. Code runs in a child with Node filesystem permissions, no network/child processes/native addons. Write files inside workspace and return {files:[names]}. All outputs are inspected; render/review/deliver separately. Use this for tables, charts, templates, tracked changes, comments, PDF merging/forms and operations beyond office_create/office_edit.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceTaskId": {
            "type": "string",
            "minLength": 1
          },
          "inputFiles": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          }
        },
        "required": [
          "code"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_create",
      "name": "office create",
      "description": "Create Word/PDF from title and paragraphs, PowerPoint from slides, or Excel from sheets. Returns taskId and file; render and review before office_deliver.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "docx",
              "pdf",
              "pptx",
              "xlsx"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string"
            }
          },
          "slides": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 50
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "body"
              ]
            }
          },
          "sheets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "rows": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "formula": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "formula"
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              "required": [
                "name",
                "rows"
              ]
            }
          }
        },
        "required": [
          "format",
          "name"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_inspect",
      "name": "office inspect",
      "description": "Read document text and structural checks. Excel returns formulas and cached results. This is not visual QA.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId",
          "file"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_edit",
      "name": "office edit",
      "description": "Make exact text replacements in DOCX/PPTX or set explicit Excel cells while preserving untouched ZIP parts. Refuse edits with no match. PDF editing uses conversion or recreation. Always creates a new file.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "replacements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          },
          "cells": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sheet": {
                  "type": "string",
                  "minLength": 1
                },
                "address": {
                  "type": "string",
                  "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "formula": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sheet",
                "address"
              ]
            }
          }
        },
        "required": [
          "taskId",
          "file",
          "name"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_convert",
      "name": "office convert",
      "description": "Convert Office files to PDF, or CSV/TSV to XLSX, using isolated LibreOffice. Excel normalization/recalculation requires allowLossy=true because LibreOffice may change unsupported objects. Refuse macro files.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "pdf",
              "xlsx"
            ]
          },
          "allowLossy": {
            "type": "boolean"
          },
          "csv": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "delimiter": {
                "enum": [
                  ",",
                  ";",
                  "\t"
                ]
              },
              "encoding": {
                "enum": [
                  "UTF-8"
                ]
              },
              "bom": {
                "enum": [
                  "present",
                  "absent"
                ]
              },
              "quote": {
                "const": "\""
              },
              "newline": {
                "enum": [
                  "lf",
                  "crlf"
                ]
              },
              "malformedRows": {
                "const": "reject"
              }
            },
            "required": [
              "delimiter",
              "encoding",
              "bom",
              "quote",
              "newline",
              "malformedRows"
            ]
          }
        },
        "required": [
          "taskId",
          "file",
          "format"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_render",
      "name": "office render",
      "description": "Render the actual file to PDF and PNG pages. Returns page count and revision. Use office_review_page for EVERY page to see actual images before office_deliver.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId",
          "file"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_review_page",
      "name": "office review page",
      "description": "View one rendered PNG page as an image in the tool response. Inspect each page for overflow, missing glyphs, broken tables and layout defects before delivery.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "taskId",
          "file",
          "revision",
          "page"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "office_deliver",
      "name": "office deliver",
      "description": "Deliver a structurally checked file only after all rendered pages have been inspected. Pass the revision and exact reviewedPages from office_render. Any edit invalidates the previous review. Publishes a preview/download and a workspace output.",
      "execution": "request",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "reviewedPages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "reviewNotes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId",
          "file",
          "revision",
          "reviewedPages",
          "reviewNotes"
        ]
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ]
}
