# Desktop edition (cn or intl; defaults to intl)
MEMMY_APP_EDITION=intl

# Cloud service
MEMMY_CLOUD_SERVICE=https://memmy-api.memtensor.cn

# Analytics (GA4)
MEMMY_GA4_MEASUREMENT_ID=

# Legal agreement page base URLs
MEMMY_LEGAL_CN_BASE_URL=https://memmy.cn
MEMMY_LEGAL_INTL_BASE_URL=https://memmy.bot

# Exact hosts available to sandboxed command plugins. Keep this aligned with
# the first-party literature-review plugin's declared academic providers.
MEMMY_COMMAND_PLUGIN_NETWORK_ALLOWLIST=export.arxiv.org,arxiv.org,eutils.ncbi.nlm.nih.gov,pmc.ncbi.nlm.nih.gov,api.openalex.org,api.crossref.org

# Trusted MPP registry. Defaults to the Cloud service, which serves
# entitlement-gated releases; set this only to point at another registry.
# HTTPS is required except for a loopback development registry.
MEMMY_PLUGIN_REGISTRY_URL=
