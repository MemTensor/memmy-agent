# Desktop edition (cn or intl; defaults to intl)
MEMMY_APP_EDITION=intl

# Cloud service
MEMMY_CLOUD_SERVICE=https://memmy-api.memtensor.cn

# Analytics (GA4)
MEMMY_GA4_MEASUREMENT_ID=

# Legal agreement page base URLs
MEMMY_LEGAL_CN_BASE_URL=https://memmy.cn
MEMMY_LEGAL_INTL_BASE_URL=https://memmy.bot

# Exact hosts available to sandboxed command plugins. The default is the same
# arXiv-only pair: export.arxiv.org for API queries and arxiv.org for papers.
MEMMY_COMMAND_PLUGIN_NETWORK_ALLOWLIST=export.arxiv.org,arxiv.org

# Trusted MPP registry. HTTPS is required except for a loopback development registry.
MEMMY_PLUGIN_REGISTRY_URL=
