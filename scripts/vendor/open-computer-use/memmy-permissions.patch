+import Foundation
+
+// A deliberately narrow observation interface: implementations expose displays
+// and capture pixels, never application launch, focus or window recovery.
+struct ScreenObservationDisplay: Equatable, Sendable {
+    let id: UInt32
+    let width: Int
+    let height: Int
+    let originX: Double
+    let originY: Double
+    let isMain: Bool
+}
+
+struct ScreenObservationImage: Sendable {
+    let pngData: Data
+    let width: Int
+    let height: Int
+}
+
+protocol ScreenObservationProvider {
+    func displays() throws -> [ScreenObservationDisplay]
+    func capture(display: ScreenObservationDisplay, width: Int, height: Int) throws -> ScreenObservationImage
+}
+
+struct ScreenObservationFailure: LocalizedError {
+    let message: String
+    var errorDescription: String? { message }
+}
+
+struct ScreenObservationResult {
+    let display: ScreenObservationDisplay
+    let availableDisplays: [ScreenObservationDisplay]
+    let image: ScreenObservationImage
+}
+
+func observeCurrentScreen(
+    displayID: UInt32? = nil,
+    provider: any ScreenObservationProvider
+) throws -> ScreenObservationResult {
+    let displays = try provider.displays().sorted { $0.id < $1.id }
+    guard !displays.isEmpty else {
+        throw ScreenObservationFailure(message: "No display is available to capture. No application was opened or activated.")
+    }
+    let selected: ScreenObservationDisplay
+    if let displayID {
+        guard let match = displays.first(where: { $0.id == displayID }) else {
+            throw ScreenObservationFailure(message: "Display \(displayID) is unavailable. Available display IDs: \(displays.map { String($0.id) }.joined(separator: ", ")).")
+        }
+        selected = match
+    } else {
+        selected = displays.first(where: \.isMain) ?? displays[0]
+    }
+    guard selected.width > 0, selected.height > 0 else {
+        throw ScreenObservationFailure(message: "Display \(selected.id) has invalid dimensions.")
+    }
+    let scale = min(1.0, 1600.0 / Double(max(selected.width, selected.height)))
+    let width = max(1, Int((Double(selected.width) * scale).rounded()))
+    let height = max(1, Int((Double(selected.height) * scale).rounded()))
+    let image = try provider.capture(display: selected, width: width, height: height)
+    guard !image.pngData.isEmpty, image.pngData.count <= 900_000,
+          image.width > 0, image.height > 0, max(image.width, image.height) <= 1600 else {
+        throw ScreenObservationFailure(message: "Screen capture did not produce a valid bounded image. No application was opened or activated.")
+    }
+    return ScreenObservationResult(display: selected, availableDisplays: displays, image: image)
+}
