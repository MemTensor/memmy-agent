+import CoreGraphics
+import Foundation
+import ImageIO
+import ScreenCaptureKit
+
+struct ScreenCaptureObservationProvider: ScreenObservationProvider {
+    private let availableDisplays: [ScreenObservationDisplay]
+
+    init() throws {
+        guard CGPreflightScreenCaptureAccess() else {
+            throw ComputerUseError.permissionDenied("Screen Recording permission is required. Run `open-computer-use doctor` and grant access to Open Computer Use.")
+        }
+        let mainDisplayID = CGMainDisplayID()
+        availableDisplays = try BlockingAsyncBridge.run(timeout: screenshotCaptureTimeout) {
+            let content = try await SCShareableContent.current
+            return content.displays.map { display in
+                ScreenObservationDisplay(id: display.displayID, width: display.width, height: display.height,
+                    originX: display.frame.origin.x, originY: display.frame.origin.y, isMain: display.displayID == mainDisplayID)
+            }
+        }
+    }
+
+    func displays() throws -> [ScreenObservationDisplay] {
+        availableDisplays
+    }
+
+    func capture(display: ScreenObservationDisplay, width: Int, height: Int) throws -> ScreenObservationImage {
+        let image = try BlockingAsyncBridge.run(timeout: screenshotCaptureTimeout) {
+            // Keep non-Sendable ScreenCaptureKit objects on the capture task.
+            let content = try await SCShareableContent.current
+            guard let target = content.displays.first(where: { $0.displayID == display.id }) else {
+                throw ScreenObservationFailure(message: "Display \(display.id) disconnected before capture.")
+            }
+            let configuration = SCStreamConfiguration()
+            configuration.width = width
+            configuration.height = height
+            configuration.showsCursor = false
+            configuration.scalesToFit = true
+            // Capture the existing composition, including the desktop. This path
+            // does not resolve, launch, activate or unminimize any application.
+            let filter = SCContentFilter(display: target, excludingWindows: [])
+            return try await SCScreenshotManager.captureImage(contentFilter: filter, configuration: configuration)
+        }
+        guard let png = boundedScreenshotPNGData(for: image, maxBytes: 900_000, maxDimension: 1600),
+              let source = CGImageSourceCreateWithData(png as CFData, nil),
+              let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any],
+              let pixelWidth = properties[kCGImagePropertyPixelWidth] as? Int,
+              let pixelHeight = properties[kCGImagePropertyPixelHeight] as? Int else {
+            throw ScreenObservationFailure(message: "Unable to encode the captured screen as PNG.")
+        }
+        return ScreenObservationImage(pngData: png, width: pixelWidth, height: pixelHeight)
+    }
+}
