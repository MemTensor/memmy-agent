{
  "name": "@memmy/migrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
