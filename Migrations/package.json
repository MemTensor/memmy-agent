  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
