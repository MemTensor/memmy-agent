{
  "manifest_version": 3,
  "name": "Memmy",
  "version": "1.0.0",
  "description": "安装后，Memmy 可以操作这个浏览器中的普通网页。",
  "key": "",
  "permissions": ["tabs", "debugger", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Memmy", "default_popup": "popup.html" },
  "minimum_chrome_version": "116"
}
